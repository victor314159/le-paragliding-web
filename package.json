{
  "name": "lepara-web",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "node scripts/check-web-inputs.ts && scripts/assemble-engine.sh && ng build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p packages/format && tsc --noEmit -p packages/engine && tsc --noEmit -p packages/engine/smoke",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "check:staged": "lint-staged",
    "prepare": "husky",
    "test": "playwright test -c tests",
    "bump:web": "node scripts/bump.ts web",
    "bump:engine": "node scripts/bump.ts engine"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@material-symbols/svg-400": "0.47.6",
    "dequal": "2.0.3",
    "dxf-viewer": "1.0.50",
    "jszip": "3.10.2",
    "rxjs": "7.8.2",
    "three": "0.186.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "@fontsource/roboto": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "http-server": "14.1.1",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.0"
  }
}
