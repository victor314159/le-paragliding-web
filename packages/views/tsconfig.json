{
  // Type-checked against the sources of its dependencies. scripts/assemble-package.sh
  // compiles it with tsconfig.build.json, against their assembled declarations.
  "extends": "../format/tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "paths": {
      "@lepara/design": ["../design/src/index.ts"],
      "@lepara/format": ["../format/src/index.ts"],
      "@lepara/geometry": ["../geometry/src/index.ts"],
      "@lepara/preprocessor": ["../preprocessor/src/index.ts"]
    }
  },
  "include": ["src"]
}
