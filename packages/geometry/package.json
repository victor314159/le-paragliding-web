{
  "name": "@lepara/geometry",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned functional geometry models: the verified LEparagliding 3.29 port and enhanced v1.",
  "license": "GPL-3.0-only",
  "author": "victor314159",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victor314159/le-paragliding-web.git",
    "directory": "packages/geometry"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./fortran-3.29": {
      "types": "./fortran-3.29.d.ts",
      "default": "./fortran-3.29.js"
    },
    "./enhanced-v1": {
      "types": "./enhanced-v1.d.ts",
      "default": "./enhanced-v1.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "files": [
    "*.js",
    "*.d.ts",
    "fortran/",
    "enhanced/",
    "shared/"
  ],
  "sideEffects": false,
  "dependencies": {
    "@lepara/format": "0.1.0"
  }
}
